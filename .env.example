# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored - never commit real secrets.

# --- Postgres ---
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=dealflow360

# --- Backend ---
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
ENVIRONMENT=development
# Comma-separated. In production, list only your real frontend/portal origins - never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Multilingual RAG Chatbot & Gemini Flash ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHAT_TOP_K=3
CHAT_MIN_RELEVANCE=0.70
CHAT_MAX_CONTEXT_CHARS=4000
CHAT_MAX_HISTORY=6
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_RATE_LIMIT=30

